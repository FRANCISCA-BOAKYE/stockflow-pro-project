{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "frontend-web"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "mobile-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "web", "--prefix", "frontend-mobile/StockFlowPro"],
      "port": 8081,
      "autoPort": true
    }
  ]
}
